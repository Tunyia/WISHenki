# Скопируйте на сервер: cp .env.example .env && nano .env
# Не коммитьте .env в git!

# PostgreSQL (только внутри Docker-сети, наружу не пробрасывается)
POSTGRES_USER=wishenki
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32
POSTGRES_DB=vish_rating

# JWT для авторизации (обязательно смените!)
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# Порт сайта на хосте (обычно 80; если занят — например 8080)
HTTP_PORT=80
