# Скопируйте в .env при необходимости переопределить настройки.

# Приложение на хосте, БД в Docker (docker compose up -d) — порт 5433 на хосте:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/vish_rating

# Если позже запустите само приложение в Docker в той же сети compose, хост БД — имя сервиса:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/vish_rating

# SQL_ECHO=false

# JWT (в продакшене задайте длинный случайный SECRET_KEY):
# SECRET_KEY=
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
